# Python 缓存
__pycache__/
*.py[cod]

# 运行时数据库（seed 可在启动时自动重建）
backend/data/

# 本地环境（ASR 独立虚拟环境，含 Whisper 依赖，体积大不入库）
.venv/
.venv-asr/
venv/
*.log
.DS_Store

# 真实密钥/本地环境配置：绝不入库（.env.example 是空值模板，保留跟踪）
.env
.env.*
!/.env.example
!/backend/.env.example

# Python 测试/覆盖率产物
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# 临时下载的 wheel 与测试音频
.wheelhouse/
*.mp3
*.webm
*.wav
