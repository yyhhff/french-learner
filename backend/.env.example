# ===== 智谱 GLM（阶段二主供应商，优先级最高）=====
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ===== 通用 OpenAI 兼容别名（可选后备）=====
# 说明：仅当对应 GLM_* 未设置时生效。
# 若改用非智谱供应商，必须同时设置下面三项（否则 base_url/model 会落到上面的 GLM 默认值）。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 本地 ASR/TTS 服务（沿用 v1）=====
YAYA_ASR_URL=http://127.0.0.1:8010
