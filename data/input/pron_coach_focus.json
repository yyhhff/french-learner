{
  "version": 1,
  "note": "TASK-0067 发音教练难点句库：原创教学示例，100 句，标签化聚焦法语常见发音难点。CEFR 为教学标注，非官方定级。",
  "tags_meta": {
    "y_vs_u": "前圆唇音 /y/ 与后圆唇音 /u/ 的对立（tu/tout、vu/vous）",
    "nasal": "鼻化元音 an/en/in/on/un（temps、vin、bon）",
    "r": "小舌音 /ʁ/（rue、très、paraître）",
    "elision": "省音：元音前的 e/é 脱落（je→j'、le→l'、ne→n'）",
    "liaison": "连诵：词末辅音与后词元音连读（les amis、vous avez）"
  },
  "sentences": [
    {"id": "f001", "fr": "Tu as vu la vue ?", "cn": "你看到风景了吗？", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "vu"},
    {"id": "f002", "fr": "Vous avez vu le tout ?", "cn": "你们看到整体了吗？", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "tout"},
    {"id": "f003", "fr": "Il est tout petit.", "cn": "他很小。", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "tout"},
    {"id": "f004", "fr": "Tu habites dans la rue ?", "cn": "你住在这条街上吗？", "cefr": "A1", "tags": ["y_vs_u", "r"], "focus_word": "rue"},
    {"id": "f005", "fr": "C'est sûr, il est sur la table.", "cn": "肯定，它在桌上。", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "sûr"},
    {"id": "f006", "fr": "Elle a une jupe très courte.", "cn": "她有一条很短的裙子。", "cefr": "A1", "tags": ["y_vs_u", "r"], "focus_word": "jupe"},
    {"id": "f007", "fr": "Je veux du lait, pas de l'eau.", "cn": "我要牛奶，不是水。", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "du"},
    {"id": "f008", "fr": "Nous voulons vous voir demain.", "cn": "我们想明天见您。", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "vous"},
    {"id": "f009", "fr": "Il a lu un livre sur la lune.", "cn": "他读了一本关于月球的书。", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "lu"},
    {"id": "f010", "fr": "Tu connais ce musée ?", "cn": "你知道这个博物馆吗？", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "musée"},
    {"id": "f011", "fr": "Le bébé a dit tout doucement.", "cn": "宝宝轻轻地说。", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "doucement"},
    {"id": "f012", "fr": "Vous dites toujours oui.", "cn": "您总是说好。", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "oui"},
    {"id": "f013", "fr": "Il court dans la cour.", "cn": "他在院子里跑。", "cefr": "A2", "tags": ["y_vs_u", "r"], "focus_word": "court"},
    {"id": "f014", "fr": "J'ai vu votre fille sur la photo.", "cn": "我在照片上看到了您女儿。", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "vu"},
    {"id": "f015", "fr": "Ce n'est pas sûr du tout.", "cn": "这完全不确定。", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "sûr"},
    {"id": "f016", "fr": "Tu préfères le thé ou le café ?", "cn": "你喜欢茶还是咖啡？", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "préfères"},
    {"id": "f017", "fr": "Nous avons vu une souris.", "cn": "我们看到了一只老鼠。", "cefr": "A2", "tags": ["y_vs_u"], "focus_word": "souris"},
    {"id": "f018", "fr": "Il est très haut, presque au plafond.", "cn": "它很高，几乎到天花板。", "cefr": "B1", "tags": ["y_vs_u"], "focus_word": "haut"},
    {"id": "f019", "fr": "Tu peux rester encore un peu.", "cn": "你还可以再待一会儿。", "cefr": "A1", "tags": ["y_vs_u"], "focus_word": "peux"},
    {"id": "f020", "fr": "Vous avez trop de travail, non ?", "cn": "您工作太多了，是吧？", "cefr": "A2", "tags": ["y_vs_u", "nasal"], "focus_word": "travail"},

    {"id": "f021", "fr": "Je vais au magasin ce matin.", "cn": "我今天早上去商店。", "cefr": "A1", "tags": ["nasal"], "focus_word": "magasin"},
    {"id": "f022", "fr": "Il fait beau, on va au jardin.", "cn": "天气好，我们去花园。", "cefr": "A1", "tags": ["nasal"], "focus_word": "jardin"},
    {"id": "f023", "fr": "J'ai pris un pain et un vin.", "cn": "我拿了一个面包和一瓶酒。", "cefr": "A1", "tags": ["nasal"], "focus_word": "vin"},
    {"id": "f024", "fr": "Le temps est long, je m'ennuie.", "cn": "时间很长，我觉得无聊。", "cefr": "A2", "tags": ["nasal"], "focus_word": "temps"},
    {"id": "f025", "fr": "Elle chante une chanson française.", "cn": "她唱一首法语歌。", "cefr": "A2", "tags": ["nasal"], "focus_word": "chanson"},
    {"id": "f026", "fr": "Bonjour, comment allez-vous ?", "cn": "您好，您好吗？", "cefr": "A1", "tags": ["nasal"], "focus_word": "bonjour"},
    {"id": "f027", "fr": "Je suis content d'être ici.", "cn": "我很高兴在这里。", "cefr": "A2", "tags": ["nasal"], "focus_word": "content"},
    {"id": "f028", "fr": "Il y a du vent dans la maison.", "cn": "屋子里有风。", "cefr": "A1", "tags": ["nasal"], "focus_word": "vent"},
    {"id": "f029", "fr": "Prenez le train de huit heures.", "cn": "坐八点的火车。", "cefr": "A1", "tags": ["nasal"], "focus_word": "train"},
    {"id": "f030", "fr": "Ce garçon est né en juin.", "cn": "这个男孩出生在六月。", "cefr": "A2", "tags": ["nasal"], "focus_word": "juin"},
    {"id": "f031", "fr": "Elle vend des fleurs au marché.", "cn": "她在市场卖花。", "cefr": "A2", "tags": ["nasal"], "focus_word": "vend"},
    {"id": "f032", "fr": "Nous mangeons dans la cuisine.", "cn": "我们在厨房吃饭。", "cefr": "A1", "tags": ["nasal"], "focus_word": "mangeons"},
    {"id": "f033", "fr": "Il est important d'être patient.", "cn": "有耐心很重要。", "cefr": "B1", "tags": ["nasal"], "focus_word": "important"},
    {"id": "f034", "fr": "Le printemps est revenu enfin.", "cn": "春天终于回来了。", "cefr": "B1", "tags": ["nasal"], "focus_word": "printemps"},
    {"id": "f035", "fr": "Je comprends la question, merci.", "cn": "我理解这个问题，谢谢。", "cefr": "A2", "tags": ["nasal"], "focus_word": "comprends"},
    {"id": "f036", "fr": "Il y a cinq personnes dans la salle.", "cn": "房间里有五个人。", "cefr": "A1", "tags": ["nasal", "liaison"], "focus_word": "cinq"},
    {"id": "f037", "fr": "Mon ami habite à Lyon.", "cn": "我的朋友住在里昂。", "cefr": "A1", "tags": ["nasal"], "focus_word": "Lyon"},
    {"id": "f038", "fr": "Elle a un beau sourire.", "cn": "她有美丽的笑容。", "cefr": "A1", "tags": ["nasal"], "focus_word": "sourire"},
    {"id": "f039", "fr": "Il faut finir le travail avant midi.", "cn": "必须在中午前完成工作。", "cefr": "B1", "tags": ["nasal"], "focus_word": "finir"},
    {"id": "f040", "fr": "Je n'ai pas le temps aujourd'hui.", "cn": "我今天没时间。", "cefr": "A2", "tags": ["nasal", "elision"], "focus_word": "temps"},

    {"id": "f041", "fr": "J'habite à Paris.", "cn": "我住在巴黎。", "cefr": "A1", "tags": ["elision"], "focus_word": "J'habite"},
    {"id": "f042", "fr": "J'aime le café au lait.", "cn": "我喜欢加奶咖啡。", "cefr": "A1", "tags": ["elision"], "focus_word": "j'aime"},
    {"id": "f043", "fr": "L'école est près d'ici.", "cn": "学校在这附近。", "cefr": "A1", "tags": ["elision"], "focus_word": "l'école"},
    {"id": "f044", "fr": "Je ne sais pas, je ne crois pas.", "cn": "我不知道，我不这么认为。", "cefr": "A2", "tags": ["elision"], "focus_word": "ne...pas"},
    {"id": "f045", "fr": "Qu'est-ce que tu fais ?", "cn": "你在做什么？", "cefr": "A1", "tags": ["elision"], "focus_word": "qu'est-ce"},
    {"id": "f046", "fr": "J'ai oublié mon parapluie.", "cn": "我忘了我的雨伞。", "cefr": "A2", "tags": ["elision"], "focus_word": "j'ai"},
    {"id": "f047", "fr": "L'homme est arrivé tôt.", "cn": "那个人来得很早。", "cefr": "A2", "tags": ["elision"], "focus_word": "l'homme"},
    {"id": "f048", "fr": "Je suis désolé, je n'ai pas compris.", "cn": "对不起，我没听懂。", "cefr": "A2", "tags": ["elision"], "focus_word": "n'ai"},
    {"id": "f049", "fr": "D'accord, on se retrouve à l'heure.", "cn": "好，我们准时见。", "cefr": "A2", "tags": ["elision"], "focus_word": "l'heure"},
    {"id": "f050", "fr": "Qu'il est gentil, ce petit garçon !", "cn": "这小男孩真可爱！", "cefr": "B1", "tags": ["elision"], "focus_word": "qu'il"},
    {"id": "f051", "fr": "Je voudrais un œuf, s'il vous plaît.", "cn": "我想要一个鸡蛋，谢谢。", "cefr": "A1", "tags": ["elision"], "focus_word": "un œuf"},
    {"id": "f052", "fr": "L'eau est froide ce matin.", "cn": "今天早上水很冷。", "cefr": "A1", "tags": ["elision"], "focus_word": "l'eau"},
    {"id": "f053", "fr": "J'espère que tu vas bien.", "cn": "我希望你一切都好。", "cefr": "A2", "tags": ["elision"], "focus_word": "j'espère"},
    {"id": "f054", "fr": "On n'oublie pas les amis.", "cn": "我们不会忘记朋友。", "cefr": "A2", "tags": ["elision"], "focus_word": "n'oublie"},
    {"id": "f055", "fr": "Il n'y a personne ici.", "cn": "这里没有人。", "cefr": "A2", "tags": ["elision"], "focus_word": "n'y"},
    {"id": "f056", "fr": "L'ami de Paul est mon voisin.", "cn": "保罗的朋友是我的邻居。", "cefr": "A2", "tags": ["elision", "liaison"], "focus_word": "l'ami"},
    {"id": "f057", "fr": "J'attends l'autobus depuis dix minutes.", "cn": "我等公交十分钟了。", "cefr": "A2", "tags": ["elision"], "focus_word": "l'autobus"},
    {"id": "f058", "fr": "C'est l'heure de partir, allons-y.", "cn": "该走了，我们走吧。", "cefr": "A2", "tags": ["elision", "liaison"], "focus_word": "allons-y"},
    {"id": "f059", "fr": "Je crois qu'il a raison.", "cn": "我认为他是对的。", "cefr": "B1", "tags": ["elision", "liaison"], "focus_word": "qu'il"},
    {"id": "f060", "fr": "L'enfant joue dans le jardin.", "cn": "孩子在花园里玩。", "cefr": "A1", "tags": ["elision", "nasal"], "focus_word": "l'enfant"},

    {"id": "f061", "fr": "Les amis arrivent ce soir.", "cn": "朋友们今晚到。", "cefr": "A1", "tags": ["liaison"], "focus_word": "les amis"},
    {"id": "f062", "fr": "Vous avez un bon ami ?", "cn": "您有个好朋友吗？", "cefr": "A1", "tags": ["liaison", "nasal"], "focus_word": "vous avez"},
    {"id": "f063", "fr": "Nous allons au cinéma ensemble.", "cn": "我们一起去看电影。", "cefr": "A1", "tags": ["liaison"], "focus_word": "allons au"},
    {"id": "f064", "fr": "Il est arrêté à l'aéroport.", "cn": "他被拦在机场。", "cefr": "A2", "tags": ["liaison"], "focus_word": "est arrêté"},
    {"id": "f065", "fr": "Les enfants sont à l'école.", "cn": "孩子们在学校。", "cefr": "A1", "tags": ["liaison", "nasal"], "focus_word": "les enfants"},
    {"id": "f066", "fr": "Je vous en prie, entrez.", "cn": "请进，您请。", "cefr": "A2", "tags": ["liaison"], "focus_word": "vous en"},
    {"id": "f067", "fr": "C'est un avion énorme.", "cn": "这是一架巨大的飞机。", "cefr": "A2", "tags": ["liaison", "nasal"], "focus_word": "un avion"},
    {"id": "f068", "fr": "On va manger en ville.", "cn": "我们去城里吃饭。", "cefr": "A1", "tags": ["liaison", "nasal"], "focus_word": "manger en"},
    {"id": "f069", "fr": "Elle est assise à côté de moi.", "cn": "她坐在我旁边。", "cefr": "A2", "tags": ["liaison"], "focus_word": "est assise"},
    {"id": "f070", "fr": "Il a écrit une lettre importante.", "cn": "他写了一封重要的信。", "cefr": "B1", "tags": ["liaison", "nasal"], "focus_word": "une lettre"},
    {"id": "f071", "fr": "Nous étions très contents de venir.", "cn": "我们很高兴来。", "cefr": "B1", "tags": ["liaison", "nasal"], "focus_word": "contents de"},
    {"id": "f072", "fr": "Les heures passent vite.", "cn": "时间过得很快。", "cefr": "A2", "tags": ["liaison"], "focus_word": "les heures"},
    {"id": "f073", "fr": "Vous êtes en retard, dépêchez-vous.", "cn": "您迟到了，快点。", "cefr": "A2", "tags": ["liaison"], "focus_word": "êtes en"},
    {"id": "f074", "fr": "Ces oranges sont délicieuses.", "cn": "这些橙子很好吃。", "cefr": "A2", "tags": ["liaison", "nasal"], "focus_word": "ces oranges"},
    {"id": "f075", "fr": "Il habite en face de l'école.", "cn": "他住在学校对面。", "cefr": "A2", "tags": ["liaison", "elision"], "focus_word": "en face"},
    {"id": "f076", "fr": "Les yeux de Marie sont bleus.", "cn": "玛丽的眼睛是蓝色的。", "cefr": "A2", "tags": ["liaison", "y_vs_u"], "focus_word": "les yeux"},
    {"id": "f077", "fr": "Nous irons à l'hôtel demain matin.", "cn": "我们明早去酒店。", "cefr": "A2", "tags": ["liaison", "nasal"], "focus_word": "à l'hôtel"},
    {"id": "f078", "fr": "Ces idées sont intéressantes.", "cn": "这些想法很有趣。", "cefr": "B1", "tags": ["liaison"], "focus_word": "idées sont"},
    {"id": "f079", "fr": "Vous attendez depuis longtemps ?", "cn": "您等很久了吗？", "cefr": "A2", "tags": ["liaison", "nasal"], "focus_word": "attendez depuis"},
    {"id": "f080", "fr": "Les amis de Jean sont gentils.", "cn": "让的朋友们很友善。", "cefr": "A2", "tags": ["liaison", "nasal"], "focus_word": "amis de"},

    {"id": "f081", "fr": "Roulez doucement dans la rue.", "cn": "在街上慢慢开。", "cefr": "A2", "tags": ["r"], "focus_word": "rue"},
    {"id": "f082", "fr": "Il pleut, prends ton parapluie rouge.", "cn": "下雨了，拿你的红雨伞。", "cefr": "A1", "tags": ["r"], "focus_word": "rouge"},
    {"id": "f083", "fr": "Je travaille très tard ce soir.", "cn": "我今晚工作到很晚。", "cefr": "A2", "tags": ["r"], "focus_word": "très"},
    {"id": "f084", "fr": "Elle porte une robe verte.", "cn": "她穿一条绿裙子。", "cefr": "A1", "tags": ["r"], "focus_word": "verte"},
    {"id": "f085", "fr": "Le train part à huit heures.", "cn": "火车八点出发。", "cefr": "A1", "tags": ["r", "nasal"], "focus_word": "train"},
    {"id": "f086", "fr": "Il fait froid, ferme la fenêtre.", "cn": "天冷，关窗。", "cefr": "A1", "tags": ["r"], "focus_word": "froid"},
    {"id": "f087", "fr": "Nous marchons près du parc.", "cn": "我们在公园附近散步。", "cefr": "A2", "tags": ["r"], "focus_word": "parc"},
    {"id": "f088", "fr": "Elle a les cheveux bruns et bouclés.", "cn": "她有棕色卷发。", "cefr": "A2", "tags": ["r"], "focus_word": "bruns"},
    {"id": "f089", "fr": "Je voudrais un café, s'il vous plaît.", "cn": "我想要一杯咖啡，谢谢。", "cefr": "A1", "tags": ["r", "elision"], "focus_word": "voudrais"},
    {"id": "f090", "fr": "Il court rapidement vers la gare.", "cn": "他快速跑向车站。", "cefr": "A2", "tags": ["r"], "focus_word": "gare"},
    {"id": "f091", "fr": "C'est très difficile à prononcer.", "cn": "这很难发音。", "cefr": "B1", "tags": ["r"], "focus_word": "prononcer"},
    {"id": "f092", "fr": "Le restaurant est plutôt cher.", "cn": "这家餐厅相当贵。", "cefr": "A2", "tags": ["r"], "focus_word": "restaurant"},
    {"id": "f093", "fr": "Elle regarde la mer depuis la terrasse.", "cn": "她从露台看海。", "cefr": "B1", "tags": ["r"], "focus_word": "terrasse"},
    {"id": "f094", "fr": "Il a offert des fleurs à sa mère.", "cn": "他送花给妈妈。", "cefr": "A2", "tags": ["r"], "focus_word": "mère"},
    {"id": "f095", "fr": "On dirait qu'il va pleuvoir.", "cn": "看起来要下雨了。", "cefr": "B1", "tags": ["r"], "focus_word": "pleuvoir"},
    {"id": "f096", "fr": "Le bébé rit quand on le regarde.", "cn": "宝宝被看着时会笑。", "cefr": "A2", "tags": ["r"], "focus_word": "rit"},
    {"id": "f097", "fr": "Il écrit un roman intéressant.", "cn": "他在写一本有趣的小说。", "cefr": "B1", "tags": ["r", "nasal"], "focus_word": "roman"},
    {"id": "f098", "fr": "Je préfère le printemps à l'hiver.", "cn": "我喜欢春天胜过冬天。", "cefr": "B1", "tags": ["r", "nasal"], "focus_word": "hiver"},
    {"id": "f099", "fr": "Elle travaille dans une grande entreprise.", "cn": "她在一家大公司工作。", "cefr": "B1", "tags": ["r", "nasal"], "focus_word": "entreprise"},
    {"id": "f100", "fr": "Fermez la porte, il fait trop froid dehors.", "cn": "关门吧，外面太冷了。", "cefr": "A2", "tags": ["r"], "focus_word": "porte"}
  ]
}
