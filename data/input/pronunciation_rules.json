{
  "version": 1,
  "rules": [
    {
      "id": "ph_alpha_01",
      "group": "字母表与读音概念",
      "title": "字母名 ≠ 字母读音",
      "description_zh": "法语字母有自己的名字（比如 A 读作 /a/），但拼进单词后，它发出的音可能和名字不一样。学读音时，我们记的是『字母在词里发什么音』，不是字母名本身。慢慢来，先记住最常见的对应就好啦。",
      "examples": [
        {
          "word_fr": "Paris",
          "meaning_zh": "巴黎",
          "note_zh": "字母 a 在词里读 /a/",
          "phonetic": "/pa.ʁi/"
        },
        {
          "word_fr": "été",
          "meaning_zh": "夏天",
          "note_zh": "字母 é 在词里读 /e/",
          "phonetic": "/e.te/"
        },
        {
          "word_fr": "si",
          "meaning_zh": "如果；是的",
          "note_zh": "字母 i 在词里读 /i/",
          "phonetic": "/si/"
        },
        {
          "word_fr": "oui",
          "meaning_zh": "是的",
          "note_zh": "ou 组合读作 /w/ 再滑向 i",
          "phonetic": "/wi/"
        }
      ],
      "audio_text": "Paris, été, si, oui",
      "shadow_text_fr": "si",
      "shadow_mode": "syllable",
      "tier": "starter",
      "tags": [
        "A组",
        "字母概念"
      ],
      "patterns": []
    },
    {
      "id": "ph_alpha_02",
      "group": "字母表与读音概念",
      "title": "字母 h 一般不发音",
      "focus": "h",
      "description_zh": "法语里的 h 几乎总是『哑巴』——写出来，但读的时候完全不出声。看到 h 开头，直接读后面的音就好，不要像中文那样哈气哦。比如 homme 直接读 /ɔm/，开头的 h 是隐形的。",
      "examples": [
        {
          "word_fr": "homme",
          "meaning_zh": "男人",
          "note_zh": "h 不发音，直接读 /ɔm/",
          "phonetic": "/ɔm/"
        },
        {
          "word_fr": "heure",
          "meaning_zh": "小时；点钟",
          "note_zh": "h 不发音，读 /œʁ/",
          "phonetic": "/œʁ/"
        },
        {
          "word_fr": "hôtel",
          "meaning_zh": "旅馆",
          "note_zh": "h 不发音，读 /o.tɛl/",
          "phonetic": "/o.tɛl/"
        },
        {
          "word_fr": "herbe",
          "meaning_zh": "草",
          "note_zh": "h 不发音，读 /ɛʁb/",
          "phonetic": "/ɛʁb/"
        }
      ],
      "audio_text": "homme, heure, hôtel, herbe",
      "shadow_text_fr": "homme",
      "shadow_mode": "word",
      "tier": "starter",
      "tags": [
        "A组",
        "字母概念"
      ],
      "patterns": [
        "^h"
      ]
    },
    {
      "id": "ph_alpha_03",
      "group": "字母表与读音概念",
      "title": "字母 c 的软硬两种读法",
      "focus": "c",
      "description_zh": "字母 c 有两种读法：碰到 a、o、u 时读硬音 /k/（像『克』）；碰到 e、i、y 时读软音 /s/（像『斯』）。记住这个『看后面跟谁』的小规律，就能举一反三啦。",
      "examples": [
        {
          "word_fr": "café",
          "meaning_zh": "咖啡",
          "note_zh": "c 后跟 a，读硬音 /k/",
          "phonetic": "/ka.fe/"
        },
        {
          "word_fr": "cinq",
          "meaning_zh": "五",
          "note_zh": "c 后跟 i，读软音 /s/",
          "phonetic": "/sɛ̃k/"
        },
        {
          "word_fr": "cent",
          "meaning_zh": "一百",
          "note_zh": "c 后跟 e，读软音 /s/",
          "phonetic": "/sɑ̃/"
        },
        {
          "word_fr": "cadeau",
          "meaning_zh": "礼物",
          "note_zh": "c 后跟 a，读硬音 /k/",
          "phonetic": "/ka.do/"
        }
      ],
      "audio_text": "café, cinq, cent, cadeau",
      "shadow_text_fr": "café",
      "shadow_mode": "word",
      "tier": "starter",
      "tags": [
        "A组",
        "字母概念"
      ],
      "patterns": [
        "ca",
        "co",
        "cu",
        "ce",
        "ci",
        "cy"
      ]
    },
    {
      "id": "ph_alpha_04",
      "group": "字母表与读音概念",
      "title": "字母 g 的软硬两种读法",
      "focus": "g",
      "description_zh": "字母 g 和 c 很像，也分软硬：碰到 a、o、u 读硬音 /g/（像『哥』）；碰到 e、i、y 读软音 /ʒ/（像『日』的轻音）。慢慢读几遍，感觉就来了～",
      "examples": [
        {
          "word_fr": "gâteau",
          "meaning_zh": "蛋糕",
          "note_zh": "g 后跟 a，读硬音 /g/",
          "phonetic": "/ɡa.to/"
        },
        {
          "word_fr": "girafe",
          "meaning_zh": "长颈鹿",
          "note_zh": "g 后跟 i，读软音 /ʒ/",
          "phonetic": "/ʒi.ʁaf/"
        },
        {
          "word_fr": "gel",
          "meaning_zh": "冰冻；凝胶",
          "note_zh": "g 后跟 e，读软音 /ʒ/",
          "phonetic": "/ʒɛl/"
        },
        {
          "word_fr": "grand",
          "meaning_zh": "大的",
          "note_zh": "g 后跟 r，读硬音 /g/",
          "phonetic": "/ɡʁɑ̃/"
        }
      ],
      "audio_text": "gâteau, girafe, gel, grand",
      "shadow_text_fr": "gâteau",
      "shadow_mode": "word",
      "tier": "starter",
      "tags": [
        "A组",
        "字母概念"
      ],
      "patterns": [
        "ga",
        "go",
        "gu",
        "ge",
        "gi",
        "gy"
      ]
    },
    {
      "id": "ph_vowel_01",
      "group": "基础元音",
      "title": "元音 a 与 â：/a/ 和 /ɑ/",
      "focus": "a / â",
      "description_zh": "字母 a 通常读短音 /a/，嘴巴张大、舌头放平，像轻轻说『啊』。带帽子 ^ 的 â 读长音 /ɑ/，口型更靠后、更长一点。两者很像，先不用紧张，听到示范跟着模仿就好。",
      "examples": [
        {
          "word_fr": "papa",
          "meaning_zh": "爸爸",
          "note_zh": "a 读短音 /a/",
          "phonetic": "/pa.pa/"
        },
        {
          "word_fr": "chat",
          "meaning_zh": "猫",
          "note_zh": "a 读 /a/；留意词末 t 不发音",
          "phonetic": "/ʃa/"
        },
        {
          "word_fr": "pâte",
          "meaning_zh": "面团；酱",
          "note_zh": "â 读长音 /ɑ/，与 /a/ 不同",
          "phonetic": "/pɑt/"
        },
        {
          "word_fr": "âne",
          "meaning_zh": "驴",
          "note_zh": "â 读长音 /ɑ/",
          "phonetic": "/ɑn/"
        }
      ],
      "audio_text": "papa, chat, pâte, âne",
      "shadow_text_fr": "chat",
      "shadow_mode": "word",
      "tier": "starter",
      "tags": [
        "B组",
        "基础元音"
      ],
      "patterns": [
        "a",
        "â"
      ]
    },
    {
      "id": "ph_vowel_02",
      "group": "基础元音",
      "title": "带符号的 e：é、è、ê、ë",
      "focus": "é / è / ê / ë",
      "description_zh": "字母 e 戴上不同『帽子』，读音不同：é（闭口 é）读 /e/，像说『诶』但嘴角向两边；è 和 ê 读 /ɛ/，嘴巴张得更开；ë 很少见，也读 /ɛ/。先记 é 和 è 这两个最常用的就好啦。",
      "examples": [
        {
          "word_fr": "été",
          "meaning_zh": "夏天",
          "note_zh": "é 读闭口 /e/",
          "phonetic": "/e.te/"
        },
        {
          "word_fr": "père",
          "meaning_zh": "父亲",
          "note_zh": "è 读开口 /ɛ/",
          "phonetic": "/pɛʁ/"
        },
        {
          "word_fr": "fête",
          "meaning_zh": "节日",
          "note_zh": "ê 读开口 /ɛ/",
          "phonetic": "/fɛt/"
        },
        {
          "word_fr": "Noël",
          "meaning_zh": "圣诞节",
          "note_zh": "ë 读 /ɛ/",
          "phonetic": "/nɔ.ɛl/"
        }
      ],
      "audio_text": "été, père, fête, Noël",
      "shadow_text_fr": "été",
      "shadow_mode": "word",
      "tier": "starter",
      "tags": [
        "B组",
        "基础元音"
      ],
      "patterns": [
        "é",
        "è",
        "ê",
        "ë"
      ]
    },
    {
      "id": "ph_vowel_03",
      "group": "基础元音",
      "title": "元音 i 与 y：都读 /i/",
      "focus": "i / y",
      "description_zh": "字母 i 和 y 在法语里通常都读 /i/，舌头放平、嘴角向两边，像短促的『衣』。y 常出现在词中或词尾，把它当成 i 来读就对了。",
      "examples": [
        {
          "word_fr": "si",
          "meaning_zh": "如果",
          "note_zh": "i 读 /i/",
          "phonetic": "/si/"
        },
        {
          "word_fr": "ici",
          "meaning_zh": "这里",
          "note_zh": "两个 i 都读 /i/",
          "phonetic": "/i.si/"
        },
        {
          "word_fr": "style",
          "meaning_zh": "风格",
          "note_zh": "y 读 /i/",
          "phonetic": "/stil/"
        },
        {
          "word_fr": "physique",
          "meaning_zh": "物理的",
          "note_zh": "y 读 /i/",
          "phonetic": "/fi.zik/"
        }
      ],
      "audio_text": "si, ici, style, physique",
      "shadow_text_fr": "si",
      "shadow_mode": "syllable",
      "tier": "starter",
      "tags": [
        "B组",
        "基础元音"
      ],
      "patterns": [
        "i",
        "y"
      ]
    },
    {
      "id": "ph_vowel_04",
      "group": "基础元音",
      "title": "元音 o 与 ô：/o/ 与 /ɔ/",
      "focus": "o / ô",
      "description_zh": "字母 o 有两种常见读法：在开音节（后面没有辅音挡着）读闭口 /o/，嘴唇撅圆；在闭音节（后面跟着辅音）读开口 /ɔ/，嘴巴更放松。先听示范感受圆唇，慢慢就分清啦。",
      "examples": [
        {
          "word_fr": "mot",
          "meaning_zh": "单词",
          "note_zh": "o 在开音节读 /o/，词末 t 不发音",
          "phonetic": "/mo/"
        },
        {
          "word_fr": "porte",
          "meaning_zh": "门",
          "note_zh": "o 在闭音节读 /ɔ/，词末 e 不发音",
          "phonetic": "/pɔʁt/"
        },
        {
          "word_fr": "photo",
          "meaning_zh": "照片",
          "note_zh": "分别含闭口 /o/ 与开口 /ɔ/",
          "phonetic": "/fɔ.to/"
        },
        {
          "word_fr": "pomme",
          "meaning_zh": "苹果",
          "note_zh": "o 在闭音节读 /ɔ/",
          "phonetic": "/pɔm/"
        }
      ],
      "audio_text": "mot, porte, photo, pomme",
      "shadow_text_fr": "mot",
      "shadow_mode": "syllable",
      "tier": "starter",
      "tags": [
        "B组",
        "基础元音"
      ],
      "patterns": [
        "o",
        "ô"
      ]
    },
    {
      "id": "ph_vowel_05",
      "group": "基础元音",
      "title": "元音 u：圆唇的 /y/",
      "focus": "u",
      "description_zh": "法语的 u 读 /y/，是中文里没有的音：舌头位置像读『衣 /i/』，但嘴唇要撅圆像吹口哨。这是中文学习者的大难点，先摆好『衣』的舌位，再把嘴唇收圆，慢慢练就好～",
      "examples": [
        {
          "word_fr": "tu",
          "meaning_zh": "你",
          "note_zh": "u 读圆唇 /y/",
          "phonetic": "/ty/"
        },
        {
          "word_fr": "rue",
          "meaning_zh": "街道",
          "note_zh": "u 读 /y/，r 为小舌音",
          "phonetic": "/ʁy/"
        },
        {
          "word_fr": "lune",
          "meaning_zh": "月亮",
          "note_zh": "u 读 /y/",
          "phonetic": "/lyn/"
        },
        {
          "word_fr": "musée",
          "meaning_zh": "博物馆",
          "note_zh": "u 读 /y/",
          "phonetic": "/my.ze/"
        }
      ],
      "audio_text": "tu, rue, lune, musée",
      "shadow_text_fr": "tu",
      "shadow_mode": "syllable",
      "tier": "starter",
      "tags": [
        "B组",
        "基础元音"
      ],
      "patterns": [
        "u"
      ]
    },
    {
      "id": "ph_vowel_06",
      "group": "基础元音",
      "title": "开口 e（è/ê）和闭口 e（é）",
      "focus": "é / è / ê",
      "description_zh": "é 是闭口 /e/，嘴角向两边、口型小；è 和 ê 是开口 /ɛ/，嘴巴张得更开。对比着读：été（闭）和 père（开）。差别就在嘴巴开合的大小，多听两遍就抓住啦。",
      "examples": [
        {
          "word_fr": "été",
          "meaning_zh": "夏天",
          "note_zh": "é 闭口 /e/",
          "phonetic": "/e.te/"
        },
        {
          "word_fr": "père",
          "meaning_zh": "父亲",
          "note_zh": "è 开口 /ɛ/",
          "phonetic": "/pɛʁ/"
        },
        {
          "word_fr": "café",
          "meaning_zh": "咖啡",
          "note_zh": "é 闭口 /e/",
          "phonetic": "/ka.fe/"
        },
        {
          "word_fr": "très",
          "meaning_zh": "很；非常",
          "note_zh": "è 开口 /ɛ/",
          "phonetic": "/tʁɛ/"
        }
      ],
      "audio_text": "été, père, café, très",
      "shadow_text_fr": "très",
      "shadow_mode": "word",
      "tier": "starter",
      "tags": [
        "B组",
        "基础元音"
      ],
      "patterns": [
        "é",
        "è",
        "ê"
      ]
    },
    {
      "id": "ph_cons_01",
      "group": "基础辅音",
      "title": "字母组合 qu 读 /k/",
      "focus": "qu",
      "description_zh": "qu 几乎总是读 /k/，后面的 u 只是『帮衬』，不单独发音（像『克』）。看到 qu 直接读 /k/ 就对了。比如 qui 读 /ki/，不用读出 u 的音哦。",
      "examples": [
        {
          "word_fr": "qui",
          "meaning_zh": "谁",
          "note_zh": "qu 读 /k/，u 不发音",
          "phonetic": "/ki/"
        },
        {
          "word_fr": "quel",
          "meaning_zh": "哪个",
          "note_zh": "qu 读 /k/",
          "phonetic": "/kɛl/"
        },
        {
          "word_fr": "quatre",
          "meaning_zh": "四",
          "note_zh": "qu 读 /k/",
          "phonetic": "/katʁ/"
        },
        {
          "word_fr": "question",
          "meaning_zh": "问题",
          "note_zh": "qu 读 /k/，词尾 tion 读 /sjɔ̃/",
          "phonetic": "/kɛs.tjɔ̃/"
        }
      ],
      "audio_text": "qui, quel, quatre, question",
      "shadow_text_fr": "qui",
      "shadow_mode": "syllable",
      "tier": "starter",
      "tags": [
        "C组",
        "基础辅音"
      ],
      "patterns": [
        "qu"
      ]
    },
    {
