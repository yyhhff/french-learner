          "word_fr": "baguette",
          "meaning_zh": "法棍面包",
          "note_zh": "gu 读 /g/",
          "phonetic": "/ba.ɡɛt/"
        }
      ],
      "audio_text": "guerre, guitare, guide, baguette",
      "shadow_text_fr": "guitare",
      "shadow_mode": "word",
      "tier": "core",
      "tags": [
        "C组",
        "基础辅音"
      ],
      "patterns": [
        "gu"
      ]
    },
