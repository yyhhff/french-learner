          "word_fr": "table",
          "meaning_zh": "桌子",
          "note_zh": "词末 e 不发音，读 /tabl/",
          "phonetic": "/tabl/"
        },
        {
          "word_fr": "livre",
          "meaning_zh": "书",
          "note_zh": "词末 e 不发音，读 /livʁ/",
