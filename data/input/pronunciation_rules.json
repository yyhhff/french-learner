    {
      "id": "ph_final_01",
      "group": "词末辅音规则",
      "title": "词末辅音一般不发音",
      "focus": "词末辅音",
      "description_zh": "这是中文学习者最容易踩的坑：法语单词末尾的辅音字母通常不发音。比如 maison 的 s、chat 的 t、lait 的 t，写出来却读不出来。中文习惯逐字母读，这里一定要改过来——看到词末辅音，轻轻『吞掉』它就好。",
      "examples": [
        {
          "word_fr": "maison",
          "meaning_zh": "房子",
          "note_zh": "词末 s 不发音，读 /mɛ.zɔ̃/",
          "phonetic": "/mɛ.zɔ̃/"
        },
        {
          "word_fr": "chat",
          "meaning_zh": "猫",
          "note_zh": "词末 t 不发音，读 /ʃa/",
          "phonetic": "/ʃa/"
        },
        {
          "word_fr": "lait",
          "meaning_zh": "牛奶",
          "note_zh": "词末 t 不发音，读 /lɛ/",
          "phonetic": "/lɛ/"
        },
        {
          "word_fr": "vous",
          "meaning_zh": "您；你们",
          "note_zh": "词末 s 不发音，读 /vu/",
          "phonetic": "/vu/"
        }
      ],
      "audio_text": "maison, chat, lait, vous",
