          "meaning_zh": "他有",
          "note_zh": "词末 l 与元音连音读 /i.la/",
          "phonetic": "/i.la/"
        },
        {
          "word_fr": "on a",
          "meaning_zh": "我们有",
          "note_zh": "词末 n 与元音连音读 /ɔ̃.na/",
          "phonetic": "/ɔ̃.na/"
        }
      ],
      "audio_text": "il est, elle a, il a, on a",
