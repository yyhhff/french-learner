    {
      "id": "ph_except_03",
      "group": "高频例外与易错",
      "title": "数字的特殊读音",
      "focus": "数字读音",
      "description_zh": "法语数字有一些特别读音，要单独记：cinq（五）读 /sɛ̃k/，six（六）读 /sis/，huit（八）读 /ɥit/，neuf（九）读 /nœf/。它们的词末辅音在单独读时要发出来，和前面『词末辅音不发音』的通则不同——这就是数字的小脾气，记牢这几个就好。",
      "examples": [
        {
          "word_fr": "cinq",
          "meaning_zh": "五",
          "note_zh": "词末 q 发音，读 /sɛ̃k/",
          "phonetic": "/sɛ̃k/"
        },
        {
          "word_fr": "six",
          "meaning_zh": "六",
          "note_zh": "词末 x 发音，读 /sis/",
          "phonetic": "/sis/"
        },
        {
          "word_fr": "huit",
          "meaning_zh": "八",
          "note_zh": "读 /ɥit/，嘘音 h 不发音",
          "phonetic": "/ɥit/"
        },
        {
          "word_fr": "neuf",
          "meaning_zh": "九",
          "note_zh": "词末 f 发音，读 /nœf/",
          "phonetic": "/nœf/"
        }
      ],
      "audio_text": "cinq, six, huit, neuf",
      "shadow_text_fr": "cinq",
      "shadow_mode": "syllable",
      "tier": "core",
      "tags": [
