          "note_zh": "s 与元音联诵读 /z/",
          "phonetic": "/vu.za.ve/"
        },
        {
          "word_fr": "les enfants",
          "meaning_zh": "孩子们",
          "note_zh": "s 与元音联诵读 /z/",
          "phonetic": "/le.zɑ̃.fɑ̃/"
        }
      ],
      "audio_text": "les amis, un homme, vous avez, les enfants",
      "shadow_text_fr": "les amis",
